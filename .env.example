# Copy this file to .env.local for local development, and enter the same
# values in Vercel's Project Settings > Environment Variables for production.

# --- Supabase (Project Settings > API in your Supabase dashboard) ---
# Use a NEW Supabase project for this app -- separate from the Young Adults
# app's database.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Leader access ---
# The PIN choir leaders type in to unlock posting + editing.
LEADER_PIN=choose-a-pin

# A long random string used to sign the leader session cookie. Generate one
# with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Push notifications ---
# Generate both with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:youremail@example.com

# --- Cron security ---
# A random string of your choosing. Vercel automatically sends this as a
# Bearer token when it triggers the daily cleanup job, so only Vercel's own
# scheduler can call that endpoint. Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-another-random-string
